# Docker Compose environment. Copy to .env before `docker compose up --build`
# (or run with `docker compose --env-file .env.docker up --build`).
# Change POSTGRES_PASSWORD and JWT_SECRET before any real deployment.

POSTGRES_DB=student_house
POSTGRES_USER=student_house
POSTGRES_PASSWORD=student_house

# Host is the postgres *service name* on the compose network, not localhost.
DATABASE_URL=postgres://student_house:student_house@postgres:5432/student_house?sslmode=disable

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CONTRACT_RESPONSE_DEADLINE_DAYS=7
CONTRACT_EXPIRY_CHECK_INTERVAL_MINUTES=60
CONTRACT_REMINDER_HOURS_BEFORE_DEADLINE=24
DATA_RETENTION_DAYS=365
DATA_RETENTION_CHECK_INTERVAL_HOURS=24
ACADEMIC_YEAR_CHECK_INTERVAL_HOURS=12
UPLOAD_DIR=/app/uploads

# Gmail: use an app password (https://myaccount.google.com/apppasswords),
# not your real account password. Empty username/password disables sending
# (student approval emails are just skipped, logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Where the "report a bug/suggestion" feedback form emails to. Empty
# defaults to SMTP_FROM (i.e. the server emails itself).
FEEDBACK_EMAIL=

# Baked into the frontend JS bundle at image build time (see frontend/Dockerfile) —
# changing this requires `docker compose up --build frontend` to take effect.
VITE_API_BASE_URL=/api/v1

# Host port that nginx (frontend) is published on.
FRONTEND_PORT=8080

# AI checks of uploaded required documents (type, holder name, issue date,
# tampering signs) and the in-app assistant, via alem.ai (model qwen3-8).
# Model, limits and prompts are fixed in code (backend/internal/service/
# ai_config.go); in the admin panel an admin only picks which roles may use
# the assistant. No key disables both features.
ALEM_API_KEY=

# Web Push notifications to phones that added the site to their home screen.
# Generate the pair once with `cd backend && go run ./cmd/vapidkeys` and never
# change it afterwards: new keys make every existing subscription stop
# receiving pushes. Empty keys disable push (the app and email still work).
# Push only works over HTTPS (or on localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact push services may use to reach whoever runs this server.
VAPID_SUBJECT=https://korkyt.edu.kz
