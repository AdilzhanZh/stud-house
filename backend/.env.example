SERVER_PORT=8080
DATABASE_URL=postgres://student_house:student_house@localhost:5432/student_house?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CONTRACT_RESPONSE_DEADLINE_DAYS=7
CONTRACT_EXPIRY_CHECK_INTERVAL_MINUTES=60
CONTRACT_REMINDER_HOURS_BEFORE_DEADLINE=24
UPLOAD_DIR=./uploads

# How long applications, contracts, and protocols are kept before being
# permanently deleted, and how often the background sweep runs.
DATA_RETENTION_DAYS=365
DATA_RETENTION_CHECK_INTERVAL_HOURS=24

# How often to check whether the July 30 student course-rollover
# (course++, or graduate if already at the degree's final course) is due.
# Checked repeatedly rather than fired once, so an outage on the cutoff day
# just delays it instead of skipping it.
ACADEMIC_YEAR_CHECK_INTERVAL_HOURS=12

# Gmail: use an app password (https://myaccount.google.com/apppasswords),
# not your real account password. Empty username/password disables sending
# (student approval emails are just skipped, logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Where the "report a bug/suggestion" feedback form emails to. Empty
# defaults to SMTP_FROM (i.e. the server emails itself).
FEEDBACK_EMAIL=

# AI checks of uploaded required documents (type, holder name, issue date,
# tampering signs) and the in-app assistant. Set ONE key:
#   OPENROUTER_API_KEY — OpenRouter (https://openrouter.ai/keys), free
#     ":free" models work; documents/questions go to the model's provider.
#   ANTHROPIC_API_KEY  — the Claude API directly.
# No key disables both: uploads are then triaged on completeness alone.
# Models can be changed later in the admin panel ("AI settings"); empty
# here = the provider's default (OpenRouter: nvidia/nemotron-3.5-super-vl:free,
# Anthropic: claude-opus-5-5).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DOCUMENT_CHECK_MODEL=

# In-app chat assistant (same API key). Effort low keeps replies quick;
# the daily limit is chat messages per user per 24 hours.
ASSISTANT_MODEL=
ASSISTANT_EFFORT=low
ASSISTANT_DAILY_LIMIT=50
