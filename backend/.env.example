SERVER_PORT=8080
DATABASE_URL=postgres://student_house:student_house@localhost:5432/student_house?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CONTRACT_RESPONSE_DEADLINE_DAYS=7
CONTRACT_EXPIRY_CHECK_INTERVAL_MINUTES=60
CONTRACT_REMINDER_HOURS_BEFORE_DEADLINE=24
UPLOAD_DIR=./uploads

# Gmail: use an app password (https://myaccount.google.com/apppasswords),
# not your real account password. Empty username/password disables sending
# (student approval emails are just skipped, logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Where the "report a bug/suggestion" feedback form emails to. Empty
# defaults to SMTP_FROM (i.e. the server emails itself).
FEEDBACK_EMAIL=
